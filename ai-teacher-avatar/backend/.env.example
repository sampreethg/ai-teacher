PORT=3001
FRONTEND_ORIGIN=http://localhost:3000
LIVEAVATAR_API_URL=https://api.liveavatar.com
LIVEAVATAR_API_KEY=replace-with-server-side-secret
LIVEAVATAR_AVATAR_ID=your-avatar-uuid
LIVEAVATAR_VOICE_ID=your-voice-uuid
LIVEAVATAR_CONTEXT_ID=your-context-uuid
LIVEAVATAR_LANGUAGE=en
LIVEAVATAR_IS_SANDBOX=true

# Authentication session validation (shared with NextAuth)
NEXTAUTH_SECRET=your-nextauth-secret-key
# Optional service-to-service internal authorization key
AVATAR_INTERNAL_SECRET=

